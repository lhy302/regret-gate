# 后悔承诺门 · Harness —— 环境变量示例
#
# 复制需要的那几行到 PowerShell 里执行即可；**本文件不要填真实密钥**，也不要把
# 填好的版本提交到仓库。
#
# 用法（PowerShell，当前会话有效）：
#   $env:REGRET_GATE_API_KEY = "sk-..."
#   .\regret-gate-harness.exe run --provider openai --base-url https://api.openai.com/v1 `
#       --model gpt-4o-2024-08-06 --group A,F --limit 20 --runs 3
#
# 启动器（GUI）优先读 REGRET_GATE_API_KEY / REGRET_GATE_BASE_URL；
# 命令行模式在 provider=openai 时兜底读 OPENAI_API_KEY，provider=anthropic 时读 ANTHROPIC_API_KEY。
# 密钥不会被写进配置、日志或审计（审计只记 model / base_url / request_id）。

# --- 通用（最高优先级） ---
# REGRET_GATE_API_KEY=sk-xxxx
# REGRET_GATE_BASE_URL=https://api.openai.com/v1
# REGRET_GATE_PROVIDER=openai
# REGRET_GATE_MODEL=gpt-4o-2024-08-06

# --- OpenAI 兼容端点 ---
# OPENAI_API_KEY=sk-xxxx
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic ---
# ANTHROPIC_API_KEY=sk-ant-xxxx
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# --- 可选：强制子进程用 UTF-8（中文任务集在 GBK 控制台下会乱码） ---
PYTHONIOENCODING=utf-8
PYTHONUTF8=1
